# ============================================================
# .env.example — SSoT humana. Mirror de .env.prod con placeholders.
# Copia a `.env` y completa los valores marcados.
# CI no lee este archivo (ver .github/workflows/*.yml — usan GH Secrets).
# ============================================================

# --- General ---
PROJECT_NAME="Nicolify"
LOG_LEVEL=INFO
API_SECRET_KEY=change_me_in_production
DOMAIN_NAME=localhost
TRAEFIK_NETWORK=web_gateway
API_DOMAIN=localhost
DASHBOARD_DOMAIN=http://localhost:3000
API_URL=http://backend:8000

# --- Frontend ---
NEXT_PUBLIC_API_URL=http://localhost:8000
INTERNAL_API_URL=http://backend:8000
# Local-only (dev-app.nicolify.com via Cloudflare tunnel). En prod = DASHBOARD_DOMAIN.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- AI Provider Selection ---
# Opciones: 'openai', 'gemini'
AI_PROVIDER=openai

# file: prompts locales (código) — recomendado para development
# hybrid: busca en BD, si falla cae a locales
# db: solo prompts de BD
PROMPT_SOURCE=file

# --- AI Model Registry (role → model) ---
# S3 PR-1 (PI-2) D-10: NANO+FAST → deepseek-v4-flash (4-15x cost reduction
# vs gpt-4o-mini, research 2026-04-30 valida ≥0.95 calidad). Rollback = 1
# env var revert. Eval gate S5 = guardrail forward.
AI_MODEL_NANO=deepseek-v4-flash
AI_MODEL_FAST=deepseek-v4-flash
AI_MODEL_REASONING=deepseek-reasoner
AI_MODEL_AGENT=kimi-k2.6
AI_MODEL_VISION=gpt-4o
AI_MODEL_EMBEDDING=text-embedding-3-large

# --- Per-role provider override (Sprint 0 multi-provider routing) ---
# Empty/unset → fallback a AI_PROVIDER global.
AI_PROVIDER_NANO=deepseek
AI_PROVIDER_FAST=deepseek
AI_PROVIDER_REASONING=deepseek
AI_PROVIDER_AGENT=kimi
AI_PROVIDER_VISION=openai
AI_PROVIDER_EMBEDDING=openai

# --- LLM API Keys ---
OPENAI_API_KEY=sk-your-openai-key
DEEPSEEK_API_KEY=sk-your-deepseek-key
KIMI_API_KEY=sk-your-kimi-key
DASHSCOPE_API_KEY=
GEMINI_API_KEY=

# --- LiteLLM Proxy (PI-2 S3 PR-2) ---
# Endpoint del proxy (Docker internal). Local dev sin compose: http://localhost:4000/v1
LITELLM_BASE_URL=http://visionarias_litellm:4000/v1
# Master key — CAMBIAR en prod. Nunca commitear valor real.
LITELLM_MASTER_KEY=sk-litellm-master-dev
# Salt key — NO cambiar post-deployment (re-keying required).
LITELLM_SALT_KEY=sk-litellm-salt-dev
# Toggle global. false = emergency rollback al router legacy.
LITELLM_PROXY_ENABLED=true
# Environment tag — DEBE matchear `supported_environments` declarado en litellm_config.yaml per model. Valores: dev | staging | production.
LITELLM_ENVIRONMENT=dev

# --- WhatsApp / Meta (Live Number) ---
WHATSAPP_API_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token

# --- Meta Facebook / Instagram (Graph API) ---
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret
META_VERIFY_TOKEN=your_custom_verify_token
META_REDIRECT_URI=http://localhost:3000/connections
META_CONFIG_ID=your_meta_config_id

# --- Instagram App (Login for Business) ---
INSTAGRAM_APP_ID=your_instagram_app_id
INSTAGRAM_APP_SECRET=your_instagram_app_secret

# --- Shopify ---
SHOPIFY_APP_NAME=your-shopify-app-name
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret
SHOPIFY_APP_URL=http://localhost:8000

# --- Evolution API (WhatsApp self-hosted) ---
EVOLUTION_API_URL=http://visionarias_whatsapp:8080
EVOLUTION_API_KEY=your_evolution_api_key
EVOLUTION_API_VERSION=v2

# --- Telegram (Bot Oficial) ---
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- Qdrant ---
QDRANT_URL=http://qdrant:6333
QDRANT_API_KEY=your_qdrant_api_key
QDRANT_COLLECTION=visionarias_knowledge

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=visionarias_logs
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Clerk Authentication (Frontend & Backend) ---
# Reemplazar con llaves reales de https://dashboard.clerk.com
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_clerk_publishable_key
CLERK_SECRET_KEY=sk_test_your_clerk_secret_key
CLERK_ISSUER=https://your-clerk-domain.clerk.accounts.dev
CLERK_DOMAIN=your-clerk-domain.clerk.accounts.dev
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/
# E2E only — Clerk testing session (Playwright)
CLERK_TEST_SESSION_ID=

NODE_ENV=development

# --- Google OAuth (Connections) ---
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/connections/google/callback

# --- CORS ---
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000"]

# --- Cloudflare (R2 Storage + Custom Domains) ---
STORAGE_PROVIDER=R2
CLOUDFLARE_ACCOUNT_ID=
# CF API token usado por el módulo domains (Workers KV + Custom Hostnames).
# R2 storage usa R2_ACCESS_KEY_ID/R2_SECRET_ACCESS_KEY abajo — NO este token.
# Permisos requeridos (Custom Token):
#   Account > Workers Scripts: Edit
#   Account > Workers KV Storage: Edit
#   Zone (nicolify.com) > Zone: Read
#   Zone (nicolify.com) > Workers Routes: Edit
#   Zone (nicolify.com) > SSL and Certificates: Edit  ← cubre Custom Hostnames API
# Crear en: https://dash.cloudflare.com/profile/api-tokens → Create Token → Custom Token
CLOUDFLARE_API_TOKEN=
# Zone ID para nicolify.com — CF Dashboard → nicolify.com → Overview (sidebar derecho)
CLOUDFLARE_ZONE_ID=
# KV Namespace "nicolify-domains" ID
CLOUDFLARE_KV_NAMESPACE_ID=
# Local-only — Cloudflare tunnel para dev-app.nicolify.com (Quick Tunnels desde dashboard)
CLOUDFLARE_TUNNEL_TOKEN=

# --- R2 Storage ---
R2_BUCKET_NAME=your-bucket-name
R2_ENDPOINT_URL=https://YOUR_ACCOUNT_ID.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://assets.example.com
# S3-compatible credentials (CF Dashboard → R2 → Manage R2 API Tokens)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# --- Sentry (Observability) ---
# Backend DSN: sentry.io → Settings → Projects → nicolify-backend → Client Keys
SENTRY_DSN=
# Worker DSN (workers/sentry-slack-alerts, etc.)
SENTRY_WORKER_DSN=
ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# CI: SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=dev
# Frontend DSN: sentry.io → Settings → Projects → nicolify-frontend → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=dev
NEXT_PUBLIC_SENTRY_RELEASE=dev
# Sourcemap upload durante Next.js build (CI/local). User Auth Token con permisos `project:releases`.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=nicolify-frontend

# ============================================================
# Sentry → Slack Alerts (Cloudflare Worker — workers/sentry-slack-alerts/)
# Estos son Worker secrets, NO app env vars. Setear con:
#   cd workers/sentry-slack-alerts && wrangler secret put SLACK_WEBHOOK_URL
#   cd workers/sentry-slack-alerts && wrangler secret put SENTRY_WEBHOOK_SECRET
# SLACK_WEBHOOK_URL     → Slack Incoming Webhook
# SENTRY_WEBHOOK_SECRET → Sentry Internal Integration client secret
# ============================================================
