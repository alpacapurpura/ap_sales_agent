# WhatsApp / Meta
WHATSAPP_API_TOKEN=your_meta_access_token
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_VERIFY_TOKEN=your_custom_verify_token
META_APP_ID="your_app_id"
META_APP_SECRET="your_app_secret"

# Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Selección de Proveedor de IA (global fallback)
# Opciones: 'openai', 'gemini'
AI_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=sk-your-openai-key

# AI Model Registry (role → model). Per-role provider override below.
AI_MODEL_NANO=gpt-4o-mini
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_REASONING=deepseek-reasoner
AI_MODEL_AGENT=kimi-k2.6
AI_MODEL_VISION=gpt-4o
AI_MODEL_EMBEDDING=text-embedding-3-large

# Per-role provider override (Sprint 0 multi-provider routing).
# Empty/unset → falls back to AI_PROVIDER global.
AI_PROVIDER_NANO=openai
AI_PROVIDER_FAST=openai
AI_PROVIDER_REASONING=deepseek
AI_PROVIDER_AGENT=kimi
AI_PROVIDER_VISION=openai
AI_PROVIDER_EMBEDDING=openai

# DeepSeek (REASONING tier) — required if AI_PROVIDER_REASONING=deepseek
DEEPSEEK_API_KEY=

# Kimi / Moonshot (AGENT tier) — required if AI_PROVIDER_AGENT=kimi
KIMI_API_KEY=

# Qwen / Alibaba DashScope intl — required if AI_PROVIDER_VISION/EMBEDDING=qwen
DASHSCOPE_API_KEY=

# Gemini (optional) — required if AI_PROVIDER=gemini
GEMINI_API_KEY=

# Redis
REDIS_URL=redis://redis:6379/0

# Qdrant
QDRANT_URL=http://qdrant:6333

# Postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=visionarias_logs
POSTGRES_HOST=postgres

# Sentry (Observability)
# Backend: get DSN from sentry.io → Settings → Projects → nicolify-backend → Client Keys
# NOTE: Create project manually at https://alpaca-purpura-to.sentry.io (API disabled project creation for members)
SENTRY_DSN=
ENVIRONMENT=dev
SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_PROFILES_SAMPLE_RATE=0.1
# Set to git SHA in CI: SENTRY_RELEASE=$(git rev-parse --short HEAD)
SENTRY_RELEASE=dev
# Frontend: get DSN from sentry.io → Settings → Projects → nicolify-frontend → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_ENVIRONMENT=dev
NEXT_PUBLIC_SENTRY_RELEASE=dev
# For source map upload during Next.js build (CI only)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=alpaca-purpura-to
SENTRY_PROJECT=nicolify-frontend

# Sentry → Slack Alerts (Cloudflare Worker — workers/sentry-slack-alerts/)
# These are Worker secrets, NOT app env vars. Set with:
#   cd workers/sentry-slack-alerts && wrangler secret put SLACK_WEBHOOK_URL
#   cd workers/sentry-slack-alerts && wrangler secret put SENTRY_WEBHOOK_SECRET
# SLACK_WEBHOOK_URL     → Slack Incoming Webhook (api.slack.com/apps → Incoming Webhooks)
# SENTRY_WEBHOOK_SECRET → Sentry Internal Integration client secret
#                         (Sentry → Settings → Developer Settings → Custom Integrations)

# Cloudflare (R2 Storage + Custom Domains)
CLOUDFLARE_ACCOUNT_ID=
# CF API token for domains module (Custom Token):
#   Account > Workers Scripts: Edit
#   Account > Workers KV Storage: Edit
#   Zone (nicolify.com) > Zone: Read
#   Zone (nicolify.com) > Workers Routes: Edit
#   Zone (nicolify.com) > SSL and Certificates: Edit  (covers Custom Hostnames API)
# Create at: https://dash.cloudflare.com/profile/api-tokens -> Create Token -> Custom Token
CLOUDFLARE_API_TOKEN=
# Zone ID for nicolify.com — CF Dashboard → nicolify.com → Overview (right sidebar)
CLOUDFLARE_ZONE_ID=
# Workers KV namespace "nicolify-domains" ID
CLOUDFLARE_KV_NAMESPACE_ID=
