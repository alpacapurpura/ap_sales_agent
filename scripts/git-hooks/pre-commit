#!/usr/bin/env bash
# Pre-commit hook — voseo detection + ruff check + ruff format + R3 SSoT
# freshness gate on staged Python/TypeScript/Markdown files.
#
# Why
# ===
# Origen: process-improvement 2026-05-05 R4 (voseo+ruff) + C1 R21
# (auditor-downstream-regression.md SSoT freshness). Sin hook, voseo
# (vos/sos/tenés/podés/mirá/dejá/etc.) + ruff F632 (identity comparison) +
# format violations llegaban a audit phase → roundtrip extra fix. Sin C1,
# devs agregaban shared/ surface nueva sin actualizar tabla SSoT R3 → R3
# downstream regression silenciosamente inefectiva (caso D4 podía repetirse).
#
# Behavior
# ========
# 1. Voseo check on staged Py/TS/TSX/MD added lines (`git diff --cached -U0`)
#    - Regex covers spanish-text.md glosario (vos/sos + 60+ verb forms)
#    - Excludes: `modules/sales_agent/` voice templates (per spanish-text.md
#      exception — sales_agent output respects tenant voice incl. voseo if AR)
#    - Excludes: `__pycache__/`, `.venv/`, `node_modules/`, `migrations/versions/`
#    - Failed → print hits + exit 1, dev fixes + re-stages
# 2. Ruff check (full ruleset) on STAGED backend/*.py via `git show :file`
#    pipe — verifies the exact content about to be committed (NOT working
#    tree which may diverge if dev edited post-stage).
# 3. Ruff format check (idem, staged content via stdin).
# 4. R3 SSoT freshness gate (origen C1 2026-05-05 — R21 process-improvement):
#    new file (status A) under `backend/src/shared/` MUST appear in the
#    inventory tabla of `.claude/rules/auditor-downstream-regression.md`,
#    OR have a `# downstream-regression-na: <reason>` magic comment within
#    the first 20 lines. Otherwise hook blocks with actionable hint.
#
# Bypass
# ======
# Per project rule (.claude/rules/git-safety.md), `git commit --no-verify`
# is FORBIDDEN. If hook fires false positive, fix root cause (rephrase
# string, mark `# noqa: voseo` with justification comment if regex
# legitimately wrong, OR add row to auditor-downstream-regression.md tabla
# OR add `# downstream-regression-na: <reason>` magic comment for genuinely
# self-contained shared/ helper).
#
# Install
# =======
#   make install-hooks    # symlinks scripts/git-hooks/pre-commit → .git/hooks/

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

# ─────────────────────────────────────────────────────────────────
# 1. Get staged files by extension
# ─────────────────────────────────────────────────────────────────

STAGED_PY=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.py$' \
  | grep -vE '(__pycache__/|\.venv/|migrations/versions/)' || true)

STAGED_TS=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.(ts|tsx)$' \
  | grep -vE '(node_modules/|\.next/|dist/)' || true)

STAGED_MD=$(git diff --cached --name-only --diff-filter=ACM \
  | grep -E '\.md$' \
  | grep -vE '(node_modules/)' || true)

ALL_TEXT_STAGED=$(printf '%s\n%s\n%s\n' "${STAGED_PY}" "${STAGED_TS}" "${STAGED_MD}" \
  | grep -v '^$' || true)

# ─────────────────────────────────────────────────────────────────
# 2. Voseo regex check on added lines only
# ─────────────────────────────────────────────────────────────────

# Glosario sourced from .claude/rules/spanish-text.md
VOSEO_REGEX='\b(vos|sos|tenés|querés|podés|sabés|hacés|venís|decís|mirá|dejá|dejalo|poné|ponelo|usá|usalo|hacé|hacelo|elegí|elegilo|seleccioná|arrancá|empezá|agregá|configurá|revisá|escribí|guardá|subí|bajá|abrí|volvé|andá|cambiá|cambialo|ofrecés|cobrás|ejecutás|acompañás|activás|desactivás|linkeá|despublicala|reactivá|cancelala|validá|considerá|formulala|marcá|referís|atendés|integrás|listá|probá|mostrá|compartí|contá|explicá|fijate|acordate)\b'

VOSEO_HITS=""

if [ -n "${ALL_TEXT_STAGED}" ]; then
  while IFS= read -r FILE; do
    [ -z "${FILE}" ] && continue

    # Per spanish-text.md exception: sales_agent voice output respects tenant
    # voice (puede ser voseo si AR). Skip personality compiler / specialist
    # prompt templates that LLM consumes as voice instructions.
    case "${FILE}" in
      */modules/sales_agent/*personality*|\
      */modules/sales_agent/*specialist*|\
      */modules/sales_agent/*.j2|\
      */modules/sales_agent/*system_instruction*|\
      */modules/sales_agent/agent_identity*|\
      */tests/modules/sales_agent/*goldens*)
        continue
        ;;
    esac

    # Per spanish-text.md exception: skill SKILL.md / rules/*.md / process docs
    # may quote voseo glosario or example wrong-then-right pairs. Honor magic
    # comment in any of these forms (R25 flexible regex 2026-05-05):
    #   # voseo-allowed                     (Python comment, no reason)
    #   # voseo-allowed: optional reason    (Python comment, with reason)
    #   # voseo-allowed — optional reason   (any unicode separator + reason)
    #   <!-- voseo-allowed -->              (Markdown, no reason)
    #   <!-- voseo-allowed: optional -->    (Markdown, with reason inside)
    #   <!-- voseo-allowed — reason -->     (any unicode separator + reason)
    #
    # Regex strategy: avoid unicode chars in character classes (locale issues
    # with multi-byte chars in POSIX ERE). Use `[^>]*` for MD and end-of-line
    # tolerance for Py. Both anchored at literal `voseo-allowed`.
    if grep -qE '(#\s*voseo-allowed([: \t]|$)|<!--\s*voseo-allowed[^>]*-->)' "${FILE}" 2>/dev/null; then
      continue
    fi

    # Examine ONLY added lines in this commit (-U0 zero context)
    HITS=$(git diff --cached -U0 -- "${FILE}" 2>/dev/null \
      | grep -E '^\+' \
      | grep -vE '^\+\+\+' \
      | grep -niE "${VOSEO_REGEX}" \
      || true)

    if [ -n "${HITS}" ]; then
      VOSEO_HITS+="${FILE}:"$'\n'"${HITS}"$'\n\n'
    fi
  done <<< "${ALL_TEXT_STAGED}"
fi

if [ -n "${VOSEO_HITS}" ]; then
  printf "\033[31m"
  cat <<EOF
─────────────────────────────────────────────────────────────
PRE-COMMIT BLOCKED: voseo detected in staged changes.

EOF
  printf "${VOSEO_HITS}"
  cat <<EOF
─────────────────────────────────────────────────────────────
Per .claude/rules/spanish-text.md: tuteo (tú) only on user-facing
strings. Convert + re-stage.

Glosario voseo→neutro: see .claude/rules/spanish-text.md table.

Common conversions:
  vos     → tú          sos     → eres        tenés   → tienes
  podés   → puedes      mirá    → mira        dejá    → deja
  poné    → pon         hacé    → haz         elegí   → elige
  agregá  → agrega      configurá → configura  revisá  → revisa

Exception: modules/sales_agent/ voice templates (already excluded).
If false positive, mark file:
  # voseo-allowed: <reason>           (Python/TS comment)
  <!-- voseo-allowed: <reason> -->    (Markdown)

NEVER use --no-verify (.claude/rules/git-safety.md prohibits).
─────────────────────────────────────────────────────────────
EOF
  printf "\033[0m"
  exit 1
fi

# ─────────────────────────────────────────────────────────────────
# 3. Ruff check (full ruleset) on staged backend/*.py
# ─────────────────────────────────────────────────────────────────

STAGED_BACKEND_PY_REPO=$(echo "${STAGED_PY}" | grep -E '^backend/' || true)

if [ -n "${STAGED_BACKEND_PY_REPO}" ]; then
  if [ ! -x "${REPO_ROOT}/backend/.venv/bin/ruff" ]; then
    printf "\033[33m"
    echo "─────────────────────────────────────────────────────────────"
    echo "WARNING: backend/.venv/bin/ruff not found — skipping ruff checks."
    echo "  Run: cd backend && python -m venv .venv && .venv/bin/pip install -r requirements-dev.txt"
    echo "─────────────────────────────────────────────────────────────"
    printf "\033[0m"
  else
    RUFF="${REPO_ROOT}/backend/.venv/bin/ruff"
    RUFF_FAIL_FILES=""
    FORMAT_FAIL_FILES=""

    # Ruff check + format on STAGED content (via `git show :file` stdin) — not
    # working tree, which may diverge if dev edited post-stage. Fixes pre-existing
    # silent-pass bug where pre-commit hook accepted broken staged content if
    # working tree was clean.
    #
    # IMPORTANT: cd into `backend/` so that ruff finds `pyproject.toml` (which
    # has line-length=120) AND so that `--stdin-filename src/...` resolves the
    # __init__.py chain correctly for INP001 namespace-package detection.
    pushd "${REPO_ROOT}/backend" >/dev/null
    while IFS= read -r FILE; do
      [ -z "${FILE}" ] && continue
      RELATIVE="${FILE#backend/}"

      # Ruff check (full ruleset incl. F632)
      if ! git -C "${REPO_ROOT}" show ":${FILE}" 2>/dev/null \
          | "${RUFF}" check --no-cache --quiet --stdin-filename "${RELATIVE}" - >/dev/null 2>&1; then
        RUFF_FAIL_FILES+="${FILE} "
      fi

      # Ruff format check
      if ! git -C "${REPO_ROOT}" show ":${FILE}" 2>/dev/null \
          | "${RUFF}" format --check --quiet --stdin-filename "${RELATIVE}" - >/dev/null 2>&1; then
        FORMAT_FAIL_FILES+="${FILE} "
      fi
    done <<< "${STAGED_BACKEND_PY_REPO}"
    popd >/dev/null

    if [ -n "${RUFF_FAIL_FILES}" ]; then
      printf "\033[31m"
      cat <<EOF
─────────────────────────────────────────────────────────────
PRE-COMMIT BLOCKED: ruff check failures on STAGED content
─────────────────────────────────────────────────────────────
Files with ruff violations in staged content:
${RUFF_FAIL_FILES}

Re-run with details:
  cd backend && .venv/bin/ruff check --no-cache ${RUFF_FAIL_FILES}

Fix:
  cd backend && .venv/bin/ruff check --fix ${RUFF_FAIL_FILES}

Then \`git add\` again to re-stage fixed content. NEVER use --no-verify.
─────────────────────────────────────────────────────────────
EOF
      printf "\033[0m"
      exit 1
    fi

    if [ -n "${FORMAT_FAIL_FILES}" ]; then
      printf "\033[31m"
      cat <<EOF
─────────────────────────────────────────────────────────────
PRE-COMMIT BLOCKED: ruff format violations on STAGED content
─────────────────────────────────────────────────────────────
Files with format violations in staged content:
${FORMAT_FAIL_FILES}

Fix:
  cd backend && .venv/bin/ruff format ${FORMAT_FAIL_FILES}

Then \`git add\` again to re-stage fixed content. NEVER use --no-verify.
─────────────────────────────────────────────────────────────
EOF
      printf "\033[0m"
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────
# 4. R3 SSoT freshness gate (origen C1 2026-05-05 R21)
# ─────────────────────────────────────────────────────────────────
# New file under backend/src/shared/ MUST appear in the inventory tabla of
# .claude/rules/auditor-downstream-regression.md, OR carry magic comment
# `# downstream-regression-na: <reason>` within first 20 lines.
#
# Detects status A (added) AND R (renamed-into) — both create new shared/
# surface that needs SSoT entry.

NEW_SHARED_FILES=$(git diff --cached --name-only --diff-filter=AR 2>/dev/null \
  | grep -E '^backend/src/shared/.+\.py$' \
  | grep -vE '(__pycache__/|\.venv/|migrations/versions/|tests/)' \
  || true)

if [ -n "${NEW_SHARED_FILES}" ]; then
  SSoT_TABLE="${REPO_ROOT}/.claude/rules/auditor-downstream-regression.md"
  MISSING_FILES=""

  if [ ! -f "${SSoT_TABLE}" ]; then
    printf "\033[33m"
    echo "─────────────────────────────────────────────────────────────"
    echo "WARNING: ${SSoT_TABLE} not found — skipping R3 SSoT freshness gate."
    echo "─────────────────────────────────────────────────────────────"
    printf "\033[0m"
  else
    while IFS= read -r FILE; do
      [ -z "${FILE}" ] && continue

      # Strip 'backend/src/' prefix to match tabla SSoT path convention
      # (which uses e.g. `shared/agent_observability/cost/cost_recorder.py`).
      LOOKUP_PATH="${FILE#backend/src/}"
      LOOKUP_DIR="$(dirname "${LOOKUP_PATH}")/"

      # Check tabla — either exact path OR parent directory listed
      # (e.g. `shared/billing/` covers all Py files under that dir).
      if grep -qF "\`${LOOKUP_PATH}\`" "${SSoT_TABLE}" 2>/dev/null; then
        continue
      fi
      if grep -qF "\`${LOOKUP_DIR}\`" "${SSoT_TABLE}" 2>/dev/null; then
        continue
      fi

      # Check magic-comment escape hatch in staged file content
      if git show ":${FILE}" 2>/dev/null | head -20 | grep -qE '#\s*downstream-regression-na:'; then
        continue
      fi

      MISSING_FILES+="  - ${FILE}"$'\n'
      MISSING_FILES+="    looked up: \`${LOOKUP_PATH}\` and \`${LOOKUP_DIR}\`"$'\n'
    done <<< "${NEW_SHARED_FILES}"

    if [ -n "${MISSING_FILES}" ]; then
      printf "\033[31m"
      cat <<EOF
─────────────────────────────────────────────────────────────
PRE-COMMIT BLOCKED: R3 SSoT freshness gate (downstream-regression)
─────────────────────────────────────────────────────────────
You're adding new file(s) under backend/src/shared/ that are NOT listed
in the downstream-regression SSoT tabla. Auditors rely on that tabla to
spawn cross-surface tests (.claude/rules/auditor-downstream-regression.md
caso D4 origen).

Files missing from tabla:
${MISSING_FILES}

Resolution (pick one):

A) Add a row to .claude/rules/auditor-downstream-regression.md tabla
   with downstream_test_targets enumerating which test paths consume
   this surface. Format:

   | \`shared/<your_path>.py\` | \`tests/...\`<br>\`tests/...\` | <reason — 1 line> |

B) Mark file as truly self-contained (no cross-consumers) by adding
   to first 20 lines:

   # downstream-regression-na: <one-line reason — e.g. "private helper
   #                          for shared/X internal use, no module imports">

   Justification scrutinized at audit time — false NA = REVERT.

NEVER use --no-verify.
─────────────────────────────────────────────────────────────
EOF
      printf "\033[0m"
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────
# 5. R32 capability ↔ story status freshness (origen 2026-05-05)
# ─────────────────────────────────────────────────────────────────
# Capability YAML at docs/product/capabilities/{m}/{c}.yaml carries derived
# fields (status, stories_live, stories_planned, stories_total) that MUST
# stay synced with referenced stories under docs/product/stories/{m}/{s}.yaml.
#
# Trigger: any staged change touching docs/product/{capabilities,stories}/.
# Action: invoke reconciler --check; block on drift with hint to run fix mode.

PRODUCT_TOUCHED=$(git diff --cached --name-only --diff-filter=ACMR 2>/dev/null \
  | grep -E '^docs/product/(capabilities|stories)/' \
  || true)

if [ -n "${PRODUCT_TOUCHED}" ]; then
  RECONCILER="${REPO_ROOT}/scripts/reconcile_capabilities.py"
  VENV_PY="${REPO_ROOT}/backend/.venv/bin/python"

  if [ -x "${VENV_PY}" ] && [ -f "${RECONCILER}" ]; then
    if ! "${VENV_PY}" "${RECONCILER}" --check >/tmp/reconcile-out.txt 2>&1; then
      printf "\033[31m"
      cat <<EOF
─────────────────────────────────────────────────────────────
PRE-COMMIT BLOCKED: R32 capability status drift
─────────────────────────────────────────────────────────────
You're staging changes under docs/product/{capabilities,stories}/ but the
capability YAML derived fields (status, stories_live, stories_planned,
stories_total) no longer match the referenced stories.

Drift detail:
$(cat /tmp/reconcile-out.txt)

Resolution:
  python scripts/reconcile_capabilities.py
  git add docs/product/capabilities/
  git commit ...

NEVER use --no-verify.
─────────────────────────────────────────────────────────────
EOF
      printf "\033[0m"
      exit 1
    fi
  else
    printf "\033[33m"
    echo "WARNING: skipping R32 reconciler — venv or script missing."
    printf "\033[0m"
  fi
fi

# ─────────────────────────────────────────────────────────────────
# 6. R33 BACKLOG.yaml + BACKLOG.md freshness (origen 2026-05-05)
# ─────────────────────────────────────────────────────────────────
# BACKLOG.yaml + BACKLOG.md are auto-generated by scripts/generate_backlog.py
# from sources (ideas-pool.yaml, outcomes/, stories/, capabilities/, legacy
# pm-nico/projects-active during transition). They MUST stay fresh — drift
# means downstream consumers (visualizer, /pm bootstrap) get stale view.
#
# Trigger: any staged change touching backlog source paths.
# Action: invoke generator --check; if drift, regen + auto-stage.

BACKLOG_SOURCES_TOUCHED=$(git diff --cached --name-only --diff-filter=ACMRD 2>/dev/null \
  | grep -E '^docs/(product/(ideas-pool\.yaml|outcomes/|stories/|capabilities/|modules/)|projects/active/.+/checkpoint\.md|pm-nico/pis/active/)' \
  || true)

if [ -n "${BACKLOG_SOURCES_TOUCHED}" ]; then
  GENERATOR="${REPO_ROOT}/scripts/generate_backlog.py"
  VENV_PY="${REPO_ROOT}/backend/.venv/bin/python"

  if [ -x "${VENV_PY}" ] && [ -f "${GENERATOR}" ]; then
    if ! "${VENV_PY}" "${GENERATOR}" --check >/tmp/backlog-check.txt 2>&1; then
      # Drift detected — regenerate + auto-stage to make commit clean
      "${VENV_PY}" "${GENERATOR}" >/tmp/backlog-regen.txt 2>&1 || true
      git add docs/product/BACKLOG.yaml docs/product/BACKLOG.md 2>/dev/null || true
      printf "\033[33m"
      cat <<EOF
─────────────────────────────────────────────────────────────
R33 BACKLOG auto-regenerated
─────────────────────────────────────────────────────────────
Sources changed → docs/product/BACKLOG.{yaml,md} regenerated and re-staged.
Inspect the diff before pushing if surprised.

Generator output:
$(tail -10 /tmp/backlog-regen.txt)
─────────────────────────────────────────────────────────────
EOF
      printf "\033[0m"
    fi
  else
    printf "\033[33m"
    echo "WARNING: skipping R33 backlog generator — venv or script missing."
    printf "\033[0m"
  fi
fi

exit 0
