#!/usr/bin/env bash
# Husky pre-commit wrapper — delegates to scripts/git-hooks/pre-commit (SSoT).
#
# Why
# ===
# Husky 9.x reads hooks from .husky/ (core.hooksPath = .husky set by
# `prepare` script in frontend/package.json). Canonical hook logic lives
# in scripts/git-hooks/pre-commit so:
#   - same SSoT used by .git/hooks/ symlink path (legacy)
#   - committed + auditable
#   - non-husky setups can install via `make install-hooks` linking to
#     .git/hooks/ directly (if user disables husky)
#
# Replaces previous inline ruff-only logic. New hook adds voseo regex +
# expanded coverage. See scripts/git-hooks/pre-commit for full behavior.
#
# DO NOT add hook logic here. Edit scripts/git-hooks/pre-commit instead.

set -euo pipefail
exec "$(git rev-parse --show-toplevel)/scripts/git-hooks/pre-commit" "$@"
